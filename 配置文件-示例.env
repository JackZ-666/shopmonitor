# ============================================================
#  ShopMonitor 配置中心（示例模板，不含真实密钥）
#  使用：复制本文件为「配置文件.env」→ 改必填项 → 保存 → 双击「启动.bat」
#  说明：只需改「必填/可选」区；「高级」区有默认值，一般不用动。
#        所有项也支持同名系统环境变量（优先级更高）。
# ============================================================

# ---------- ① 服务 ----------
SHOPMONITOR_HOST=127.0.0.1    # 监听地址：本机用 127.0.0.1，公网/局域网用 0.0.0.0
SHOPMONITOR_PORT=8010         # 面板端口

# ---------- ①b 访问口令（可选） ----------
SHOPMONITOR_PASSWORD=   # 设置后需输入口令才能打开面板（留空=不启用）

# ---------- ② AI 选品分析（可选，填了才启用） ----------
# 任意 OpenAI 兼容大模型 Key 均可：豆包方舟 / 智谱 GLM / 通义千问 / DeepSeek（都有免费额度）
AI_LLM_API_KEY=               # 例：ark-xxxx 或 sk-xxxx
AI_LLM_BASE_URL=              # 留空自动按 Key 识别
AI_LLM_MODEL=                 # 留空自动按 Key 识别

# ---------- ③ 告警推送（可选，留空=只在本机记录） ----------
SHOPMONITOR_WEBHOOK_URL=      # 企业微信/钉钉/飞书群机器人地址
ALERT_EMAIL_SMTP_HOST=       # 邮件通知（可选）：如 smtp.qq.com / smtp.163.com
ALERT_EMAIL_SMTP_PORT=465
ALERT_EMAIL_USER=             # 发件邮箱
ALERT_EMAIL_PASS=             # SMTP 授权码（非登录密码）
ALERT_EMAIL_FROM=             # 发件人（留空用邮箱账号）
ALERT_EMAIL_TO=               # 收件人，多个用逗号分隔
ALERT_TELEGRAM_BOT_TOKEN=     # Telegram 机器人 Token（可选）
ALERT_TELEGRAM_CHAT_ID=       # Telegram 会话 ID      # 企业微信/钉钉/飞书群机器人地址

# ---------- ④ 平台真实数据（可选；全留空=自动用演示数据跑通） ----------
TAOBAO_COOKIE=                # 方式一：淘宝登录后浏览器 Cookie
SHOPEE_COOKIE=                # Shopee 登录 Cookie
SHOPMONITOR_JD_RANK_URL=      # 方式二：自定义 JSON 数据源（HTTP 地址或本地文件路径）
SHOPMONITOR_PDD_RANK_URL=data/拼多多榜-数据源.json
SHOPMONITOR_DOUYIN_RANK_URL=
SHOPMONITOR_TAOBAO_RANK_URL=
SHOPMONITOR_SHOPEE_RANK_URL=
SHOPMONITOR_AMAZON_RANK_URL=
SHOPMONITOR_ALIEXPRESS_RANK_URL=
JD_UNION_APP_KEY=             # 京东联盟官方 API（可选，需后台开通权限）
JD_UNION_SECRET_KEY=
JD_UNION_ELITE_ID=

# ---------- ⑤ 官方开放平台凭证（可选；接入官方 API 用，个人可先跳过） ----------
DOUYIN_MALL_APP_ID=     # 抖音商城/抖店开放平台 op.jinritemai.com（需企业认证）
DOUYIN_MALL_SECRET=
TAOBAO_APP_KEY=         # 淘宝开放平台 open.taobao.com
TAOBAO_APP_SECRET=
PDD_CLIENT_ID=          # 拼多多开放平台 open.pinduoduo.com
PDD_CLIENT_SECRET=
ALIBABA_APP_KEY=        # 1688 开放平台 open.1688.com
ALIBABA_APP_SECRET=
KUAISHOU_APP_KEY=       # 快手电商开放平台 open.kwaixiaodian.com
KUAISHOU_APP_SECRET=

# 以下为可选扩展：部分平台接口需要 token（没有则自动降级提示）
DOUYIN_MALL_ACCESS_TOKEN=    # 抖店商家授权 token（可选）
ALIBABA_ACCESS_TOKEN=        # 1688 授权 access_token（必填才能调搜索）
KUAISHOU_ACCESS_TOKEN=       # 快手授权 access_token（必填才能调商品列表）
TAOBAO_ADZONE_ID=            # 淘宝客推广位ID（可选；部分账号必填）
# ---------- ⑤b 官方开放平台凭证-跨境（可选；TikTok Shop / Amazon / Shopee / AliExpress） ----------
TIKTOK_SHOP_APP_KEY=        # TikTok Shop Partner Center 应用 AppKey（需商家授权）
TIKTOK_SHOP_APP_SECRET=
TIKTOK_SHOP_ACCESS_TOKEN=   # 商家授权 access_token（必填才能调商品搜索）
TIKTOK_SHOP_SHOP_CIPHER=    # 授权后获取的 shop_cipher（可选）
TIKTOK_SHOP_SHOP_ID=        # 店铺 shop_id（可选）
AMAZON_ACCESS_KEY=          # Amazon PA-API：AWS AccessKey（需在 AWS 开通 PA-API）
AMAZON_SECRET_KEY=          # AWS SecretKey
AMAZON_PARTNER_TAG=         # 联盟 PartnerTag（通常 -20 结尾）
AMAZON_PARTNER_TYPE=Associates   # PartnerType（默认 Associates）
AMAZON_REGION=us-east-1          # us-east-1=美亚 / eu-west-1=英亚 / us-west-2=日亚
AMAZON_HOST=                # 留空自动按 Region 识别
SHOPEE_PARTNER_ID=          # Shopee 开放平台应用 Partner ID
SHOPEE_PARTNER_KEY=         # Shopee 应用 Partner Key
SHOPEE_ACCESS_TOKEN=        # 商家授权 access_token（必填）
SHOPEE_SHOP_ID=             # 要监控的店铺 shop_id
ALIEXPRESS_OPEN_APP_KEY=    # AliExpress 联盟应用 AppKey
ALIEXPRESS_OPEN_APP_SECRET= # 联盟应用 AppSecret
ALIEXPRESS_OPEN_ACCESS_TOKEN=  # 联盟推广者授权 access_token（必填）
ALIEXPRESS_SORT=total_sales_des # 默认销量降序
ALIEXPRESS_CURRENCY=USD     # 默认 USD
ALIEXPRESS_TRACKING_ID=     # 可选；联盟推广 tracking_id

# ---------- ⑥ UUMit（一般不用动，留空自动探测） ----------
UUMIT_SKILL_DIR=

# ---------- ⑦ 高级：监控与抓取（默认值即可） ----------
SHOPMONITOR_MONITOR=1               # 随服务启动定时监控：1=开 0=关
SHOPMONITOR_MONITOR_INTERVAL=3600   # 巡检间隔（秒），3600=每小时
SHOPMONITOR_MONITOR_TOP_N=10        # 关键词监控盯前 N 名
SHOPMONITOR_TIMEOUT=10              # 请求超时（秒）
SHOPMONITOR_RANK_TTL=600            # 榜单缓存时长（秒）
SHOPMONITOR_RATE_LIMIT=2.0          # 单平台请求最小间隔（秒）
SHOPMONITOR_ALLOW_MOCK=1            # 采集失败自动降级演示数据：1=开 0=关
SHOPMONITOR_PRICE_DROP_PCT=3        # 降价告警阈值（百分比）
SHOPMONITOR_PRICE_DROP_ABS=5        # 降价告警阈值（绝对值，元）
SHOPMONITOR_RATING_DROP=0.3         # 评分下滑告警阈值
SHOPMONITOR_REVIEW_SURGE=50         # 评论激增告警阈值（条）
SHOPMONITOR_SALES_SURGE=100         # 销量激增告警阈值
SHOPMONITOR_RANK_CHANGE=3           # 排名变动告警阈值（名）
